 #  1 = 观测里加"板方位角"这一行(推荐);0 = 严格只用 3 维位置观测
 use_theta_obs: 1
+
+# 11-state model adds dr=r_odd-r_even and dh=z_odd-z_even as estimated states.
+estimate_pair_geometry: 1
+radius_min: 0.12
+radius_max: 0.40
+
+# Ordinary infantry plate installation prior (inward normal, world +z upwards).
+# Assumed mechanical pitch, NOT a calibration result for this particular robot.
+# Shared by constrained pose fitting and four-plate reprojection.
+plate_inward_pitch_deg: -15.0
+constrain_plate_pitch: 1
+plate_pitch_sigma_deg: 5.0
+plate_roll_sigma_deg: 5.0
+
+# Detector/model uncertainty priors; full covariance is propagated through the pixel Jacobian.
+# Floors represent unmodelled detector/calibration error. They are not ground-truth calibration.
+corner_sigma_px: 1.5
+position_noise_floor_m: 0.01
+yaw_noise_floor_deg: 3.0
+imu_attitude_sigma_deg: 0.3
+
+# Traditional threshold/dilation/rectangle endpoints are less precise than NN keypoints.
+# Separate priors; not calibrated ground-truth detector errors.
+traditional_corner_sigma_px: 3.0
+traditional_position_floor_m: 0.02
+traditional_yaw_floor_deg: 5.0
