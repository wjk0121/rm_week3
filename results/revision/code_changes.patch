+    for(int i=0;i<N;++i) for(int j=0;j<N;++j) for(int k=0;k<N;++k) for(int l=0;l<N;++l)
+        next[i*N+j]+=f[i*N+k]*P_[k*N+l]*f[j*N+l];
+    const double q[4]={sigma_a*sigma_a,sigma_a*sigma_a,sigma_z*sigma_z,sigma_alpha*sigma_alpha};
